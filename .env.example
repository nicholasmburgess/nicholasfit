# Copy to .env.local for local development, or add both in Vercel > Project > Settings > Environment Variables.
# Find them in Supabase > Project Settings > API. Leave empty to run in demo mode (data saved in the browser only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Exercise demo videos in the iPhone app (optional). Free "Basic" key from
# https://rapidapi.com/ascendapi/api/edb-with-videos-and-images-by-ascendapi (Apps tab after subscribing).
EXERCISEDB_RAPIDAPI_KEY=
